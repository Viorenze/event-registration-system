{
  "name": "event-registration-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "test": "vp test",
    "test:integration": "vp test -c vite.integration.config.ts --run",
    "test:concurrency": "vp test -c vite.concurrency.config.ts --run",
    "build:web": "pnpm --filter @event-system/web build",
    "gate": "vp check && vp test && pnpm test:integration && pnpm test:concurrency && pnpm --filter @event-system/db verify:migration && pnpm --filter @event-system/web build"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite-plus": "^1.3.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.14.0"
}
